@model CatalogStudio.ViewModels.ProfileViewModel
@{ViewData["Title"]="Profil";}
<section class="panel auth-card"><p class="eyebrow">HESABIM</p><h1>Profil ve marka</h1><form method="post" enctype="multipart/form-data"><div asp-validation-summary="All" class="text-danger"></div><label asp-for="FullName"></label><input asp-for="FullName" class="form-control" required/><label asp-for="BrandName"></label><input asp-for="BrandName" class="form-control" required/>@if(ViewBag.HasLogo==true){<img class="brand-preview my-3" src="/Catalog/Logo" alt="Marka logonuz"/>}<label asp-for="Logo">Yeni logo</label><div class="drop-zone"><input asp-for="Logo" type="file" accept="image/png,image/jpeg,image/webp"/><div class="previews"></div></div><button class="btn btn-primary w-100 mt-4">Kaydet</button></form></section>