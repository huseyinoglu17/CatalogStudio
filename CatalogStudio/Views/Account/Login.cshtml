@model CatalogStudio.ViewModels.LoginViewModel
@{ViewData["Title"]="Giriş yap";}
<section class="panel auth-card"><p class="eyebrow">BARIŞ KEREM HÜSEYİNOĞLU</p><h1>Atölyenize hoş geldiniz.</h1><p>Kataloglarınıza ve marka dosyalarınıza ulaşın.</p><form method="post"><div asp-validation-summary="All" class="text-danger"></div><label asp-for="Email"></label><input asp-for="Email" class="form-control" autocomplete="username" required/><label asp-for="Password"></label><input asp-for="Password" class="form-control" autocomplete="current-password" required/><label class="choice my-3"><input asp-for="RememberMe"/> Beni hatırla</label><button class="btn btn-primary w-100">Giriş yap</button></form><div class="auth-links"><a href="/Account/Register">Hesap oluştur</a><a href="/Account/ForgotPassword">Şifremi unuttum</a></div></section>