@model Catalog
@{ViewData["Title"]="Katalog hazır";}
<a class="back-link" href="/Catalog/MyCatalogs">← Kataloglarım</a>
<div class="page-heading"><div><p class="eyebrow">KATALOG HAZIR</p><h1>#@Model.ProductCode</h1><div class="catalog-tags"><span>@Model.Age</span>@if(Model.SeriesCount.HasValue){<span>@Model.SeriesCount pieces</span>}</div></div><a class="btn btn-primary" href="/Catalog/Image/@Model.Id?download=true">PNG olarak indir</a></div>
<div class="result-grid"><div><a class="result-image-link" href="/Catalog/Image/@Model.Id" target="_blank" rel="noopener" aria-label="Kataloğu tam boy aç"><img class="final-catalog" src="/Catalog/Image/@Model.Id" alt="@Model.ProductCode ürün kataloğu" width="1400" height="1100"/></a><p class="upload-help">Detayları görmek için görsele dokun. Yayınlamadan önce ürünün renk ve baskılarını kontrol et.</p></div>
<aside><section class="panel"><h2>Farklı bir çekim dene</h2>
@if(!string.IsNullOrEmpty(Model.LogoSnapshotPath)&&Model.VariantPathsJson!="[]"){<p>Aynı ürünler, logo ve bilgilerle yeni bir arka planda tekrar oluştur.</p><form asp-action="Regenerate" method="post" data-generation="true" data-confirm="Yeniden üretim 50 token harcar. Devam edilsin mi?"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-primary w-100">Yeniden oluştur · 50 token</button></form><p class="upload-help">Sonuç ayrı bir katalog olarak kaydedilir.</p>}else{<p>Bu eski kataloğun kaynak fotoğrafları saklanmamış. Tekrar oluşturmak için yeni katalog formuna yükleyebilirsin.</p><a class="btn btn-outline-dark w-100" href="/">Yeni katalog</a>}</section>
<section class="panel delete-panel"><h2>Kataloğu sil</h2><p>Bu katalog ve görseli kalıcı olarak kaldırılır.</p><form asp-controller="Catalog" asp-action="Delete" method="post" data-confirm="Bu katalog ve görseli kalıcı olarak silinsin mi?"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-delete w-100">Kataloğu sil</button></form></section></aside></div>