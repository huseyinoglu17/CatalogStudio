@inject CatalogStudio.Services.TokenService Tokens
@{
 var signedIn=User.Identity?.IsAuthenticated==true;
 var current=Context.Request.Path.Value??"/";
 var isCatalog=current.StartsWith("/Catalog");
 var isProfile=current.StartsWith("/Account/Profile");
 long balance=signedIn?await Tokens.Balance(int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value)):0;
}
<!DOCTYPE html><html lang="tr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><meta name="theme-color" content="#344b40"/><title>@ViewData["Title"] · Barış Kerem Hüseyinoğlu</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body class="@(signedIn?"signed-in":"signed-out")">
<a class="skip-link" href="#main-content">İçeriğe geç</a>
<header class="site-header"><div class="header-inner"><a class="wordmark" href="/">Barış Kerem<span>Hüseyinoğlu</span></a>
@if(signedIn){
<nav class="desktop-nav" aria-label="Ana menü"><a href="/" aria-current="@(!isCatalog&&!isProfile?"page":null)">Yeni katalog</a><a href="/Catalog/MyCatalogs" aria-current="@(isCatalog?"page":null)">Kataloglarım</a><a href="/Account/Profile" aria-current="@(isProfile?"page":null)">Profil</a></nav>
<div class="header-actions"><span class="token-badge"><strong>@balance</strong> token</span><details class="account-menu"><summary aria-label="Hesap menüsü"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg></summary><div class="account-popover"><a href="/Account/Profile">Profil ve marka</a>@if(User.IsInRole("Admin")){<a href="/Admin">Yönetim paneli</a><a href="/Admin/Tokens">Token yönetimi</a>}<form action="/Account/Logout" method="post">@Html.AntiForgeryToken()<button class="nav-button">Çıkış yap</button></form></div></details></div>
}else{<nav class="guest-nav" aria-label="Hesap"><a href="/Account/Login">Giriş yap</a><a href="/Account/Register">Kayıt ol</a></nav>}
</div></header>
<main id="main-content" class="container studio-main" tabindex="-1">@if(TempData["Message"]!=null){<div class="alert alert-info" role="status">@TempData["Message"]</div>}@RenderBody()</main>
<footer class="site-footer"><span>Barış Kerem Hüseyinoğlu</span><span>Çocuk giyim katalog atölyesi</span></footer>
@if(signedIn){<nav class="mobile-nav" aria-label="Mobil ana menü">
<a href="/" aria-current="@(!isCatalog&&!isProfile?"page":null)"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="4"/><path d="M12 8v8M8 12h8"/></svg><span>Yeni katalog</span></a>
<a href="/Catalog/MyCatalogs" aria-current="@(isCatalog?"page":null)"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="m3 16 5-5 4 4 4-6 5 7"/></svg><span>Kataloglarım</span></a>
<a href="/Account/Profile" aria-current="@(isProfile?"page":null)"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7" r="3"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg><span>Profil</span></a></nav>}
<script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>