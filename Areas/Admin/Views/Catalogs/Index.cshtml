@model List<Catalog>
<h1>Kataloglar</h1><div class="panel table-responsive"><table class="table align-middle"><thead><tr><th>Önizleme</th><th>Ürün</th><th>Kullanıcı</th><th>Tarih</th><th>İşlem</th></tr></thead><tbody>@foreach(var c in Model){<tr><td><a href="/Catalog/Image/@c.Id"><img width="160" src="/Catalog/Image/@c.Id" alt="@c.ProductCode kataloğu" loading="lazy"/></a></td><td>@c.ProductCode<br/>@c.Age</td><td>@c.User.Email</td><td>@c.CreatedAt.ToString("dd.MM.yyyy")</td><td><form action="/Admin/Catalogs/Delete" method="post" data-confirm="Katalog kalıcı olarak silinsin mi?">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.Id"/><button class="btn btn-outline-danger">Sil</button></form></td></tr>}</tbody></table></div>
