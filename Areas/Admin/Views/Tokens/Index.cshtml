@model List<AppUser>
@{ var colorTokenPrice = (int?)ViewBag.ColorTokenPrice ?? 75; }
<h1>Token yönetimi</h1>
<section class="panel token-price-panel"><p class="eyebrow">ÜRETİM FİYATLANDIRMASI</p><h2>Renk başına token ücreti</h2><p>Yeni katalogların ücreti renk sayısı × bu tutar olarak hesaplanır. Kaydettiğin fiyat tüm kullanıcılar için geçerlidir. Yeniden üretim sabit 25 tokendir.</p>
<form asp-action="UpdatePrice" method="post"><label for="color-token-price">Bir rengin token ücreti</label><input id="color-token-price" name="colorTokenPrice" value="@colorTokenPrice" type="number" inputmode="numeric" min="1" max="100000" step="1" required class="form-control"/><div class="pricing-example" id="pricing-example" aria-live="polite">4 renk = @(colorTokenPrice * 4) token</div><button class="btn btn-primary mt-3">Üretim fiyatını kaydet</button></form></section>
<section class="panel"><form method="get"><label for="search">Kullanıcı adı veya e-posta</label><input id="search" name="search" value="@ViewBag.Search" class="form-control" placeholder="Kullanıcı adı veya e-posta"/><button class="btn btn-primary mt-3">Kullanıcı bul</button></form></section>
@foreach(var u in Model){<section class="panel"><h2>@u.Email</h2><p>@u.UserName · @ViewBag.Balances[u.Id] token</p><form asp-action="Change" method="post" data-confirm="Token bakiyesi değiştirilsin mi?"><input type="hidden" name="search" value="@u.Email"/><label>Tutar</label><input name="amount" type="number" min="0" max="1000000000" value="200" required class="form-control"/><label>İşlem</label><select name="operation" class="form-select"><option value="add">Token ekle</option><option value="subtract">Token düş</option><option value="set">Bakiyeyi bu tutara ayarla</option><option value="clear">Bakiyeyi sıfırla</option></select><button class="btn btn-primary mt-3">Uygula</button></form></section>}
@if(Model.Count==0){<p>Kullanıcı bulunamadı.</p>}
