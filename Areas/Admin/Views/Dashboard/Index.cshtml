@model List<Catalog>
<p class="eyebrow">GENEL BAKIŞ</p><h1>Dashboard</h1><div class="metrics">@foreach(var item in new[]{("Kullanıcılar",(int)ViewBag.Users),("Kataloglar",(int)ViewBag.Catalogs),("Bugün (UTC)",(int)ViewBag.Today),("Markalar",(int)ViewBag.Brands)}){<div class="panel"><span>@item.Item1</span><strong>@item.Item2</strong></div>}</div><section class="panel"><h2>Son kayıt olan kullanıcılar</h2>@foreach(AppUser u in ViewBag.RecentUsers){<p><a href="/Admin/Users/Details/@u.Id">@u.FullName</a> · @u.Email · @u.CreatedAt.ToString("dd.MM.yyyy")</p>}</section><section class="panel"><h2>Son kataloglar</h2>@foreach(var c in Model){<p><a href="/Catalog/Image/@c.Id">@c.ProductCode</a> · @c.User.Email · @c.Age</p>}@if(Model.Count==0){<p>Henüz katalog oluşturulmadı.</p>}</section>
