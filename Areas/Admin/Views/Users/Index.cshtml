@model List<AppUser>
<h1>Kullanıcılar</h1><p><a class="btn btn-primary" href="/Admin/Tokens">Token yönetimi</a></p><div class="panel table-responsive"><table class="table align-middle"><thead><tr><th>Kullanıcı</th><th>Kayıt</th><th>Rol</th><th>Durum</th><th>İşlem</th></tr></thead><tbody>@foreach(var u in Model){<tr><td><a href="/Admin/Users/Details/@u.Id">@u.FullName</a><br/>@u.Email</td><td>@u.CreatedAt.ToString("dd.MM.yyyy")</td><td>@ViewBag.Roles[u.Id]</td><td>@(u.IsActive?"Aktif":"Pasif")</td><td><form action="/Admin/Users/Change" method="post" class="d-flex gap-2" data-confirm="Seçili işlemi uygulamak istiyor musunuz?">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@u.Id"/><select name="operation" class="form-select" aria-label="Kullanıcı işlemi"><option value="@(u.IsActive?"deactivate":"activate")">@(u.IsActive?"Pasif yap":"Aktif yap")</option><option value="grant">Admin yap</option><option value="revoke">Admin rolünü kaldır</option><option value="delete">Kullanıcıyı sil</option></select><button class="btn btn-outline-dark">Uygula</button></form></td></tr>}</tbody></table></div>
