@model CatalogRequest
@{ViewData["Title"]="Yeni katalog";var preference=ViewBag.Preference as UserPreference;}
<div class="page-heading"><div><p class="eyebrow">KATALOG ATÖLYESİ</p><h1>Yeni katalog</h1><p>Ürünlerini yükle, markana özel kataloğunu oluştur.</p></div><span class="format-tag">1400 × 1100 <small>PNG çıktı</small></span></div>
<form asp-controller="Catalog" asp-action="Create" method="post" enctype="multipart/form-data" id="catalog-form">
<div asp-validation-summary="All" class="validation-box text-danger" role="alert"></div>
<div class="studio-grid"><div class="form-column">
<section class="panel"><h2><span class="step">01</span>Marka ve ürün bilgileri</h2>
<label asp-for="BrandName">Marka adı</label><input asp-for="BrandName" class="form-control" placeholder="Marka adınızı girin" required maxlength="100" autocomplete="organization"/>
@if(preference!=null){<div class="saved-logo"><img src="/Catalog/Logo" alt="Kayıtlı marka logosu"/><div><p>Kayıtlı logonu tekrar kullanmak ister misin?</p><label class="choice"><input type="radio" asp-for="UseSavedLogo" value="true" required/> Evet, bu logoyu kullan</label><label class="choice"><input type="radio" asp-for="UseSavedLogo" value="false" required/> Yeni logo yükle</label></div></div>}
<div id="logo-upload"><label asp-for="Logo">Marka logosu</label><div class="drop-zone"><input asp-for="Logo" type="file" accept="image/png,image/jpeg,image/webp"/><p>Galeriden seç veya dosyayı sürükle.</p><div class="previews"></div></div></div>
<div class="field-grid"><div><label asp-for="ProductCode">Ürün kodu</label><input asp-for="ProductCode" type="number" inputmode="numeric" min="1" step="1" required class="form-control"/></div><div><label asp-for="SeriesCount">Kaçlı seri?</label><input asp-for="SeriesCount" class="form-control" type="number" inputmode="numeric" min="1" max="1000" required placeholder="Örn. 4"/></div></div>
<fieldset class="age-fieldset"><legend>Yaş aralığı</legend><div class="age-inputs"><div><label asp-for="MinimumAge">En küçük</label><input asp-for="MinimumAge" inputmode="numeric" type="number" min="0" required class="form-control"/></div><div><label asp-for="MaximumAge">En büyük</label><input asp-for="MaximumAge" inputmode="numeric" type="number" min="1" required class="form-control"/></div><div><label asp-for="AgeUnit">Birim</label><select asp-for="AgeUnit" class="form-select"><option value="Months">Ay</option><option value="Years">Yaş</option></select></div></div><small id="age-preview">Bu aralık katalogda ürün beden bilgisi olarak gösterilir.</small></fieldset>
<div class="field-grid"><div><label asp-for="ModelAge">Mankenin yaşı</label><input asp-for="ModelAge" type="number" inputmode="numeric" min="1" max="216" required class="form-control" placeholder="Örn. 9"/><span asp-validation-for="ModelAge" class="text-danger"></span></div><div><label asp-for="ModelAgeUnit">Yaş birimi</label><select asp-for="ModelAgeUnit" class="form-select" required><option value="">Seçin</option><option value="Months">Ay</option><option value="Years">Yaş</option></select></div></div><p class="upload-help">Örneğin 9 ay, 1 yaş veya 5 yaş. Ürünün beden aralığından bağımsızdır.</p><label asp-for="HasPockets">Ürün cepli mi?</label><select asp-for="HasPockets" class="form-select" required><option value="">Seçin</option><option value="true">Cepli</option><option value="false">Cepsiz</option></select><label asp-for="ModelGender">Manken cinsiyeti</label><select asp-for="ModelGender" class="form-select" required><option value="">Seçin</option><option value="Girl">Kız</option><option value="Boy">Erkek</option></select>
</section>
<section class="panel"><h2><span class="step">02</span>Mankenin giyeceği ürün</h2><p>Ürünü veya takımı gösteren tek fotoğraf seç. Tek parça ürün gerektiğinde sade beyaz içlik veya tamamlayıcı kıyafetle giydirilir.</p><div class="drop-zone main-upload"><input asp-for="MainModelProductImage" type="file" accept="image/png,image/jpeg,image/webp" required aria-label="Mankene giydirilecek ürün fotoğrafı"/><p>Fotoğraf seç veya buraya sürükle.</p><div class="previews"></div></div></section>
</div><div class="form-column">
<section class="panel"><h2><span class="step">03</span>Diğer renkler</h2><p>Kataloğun sağında gösterilecek 1–10 renk fotoğrafı seç.</p><div class="drop-zone"><input asp-for="VariantImages" type="file" accept="image/png,image/jpeg,image/webp" multiple required aria-label="Diğer renk fotoğrafları"/><p>Birden fazla fotoğraf seçebilirsin.</p><div class="previews"></div></div><p class="upload-help">PNG, JPEG veya WebP · Fotoğraf başına en fazla 10 MB</p></section>
<section class="composition-note panel"><p class="eyebrow">OLUŞTURMAYA HAZIR</p><h2>Son bir kontrol</h2><p>Logo, ürün kodu, yaş ve seri bilgisi kataloğuna eklenir. Her üretimde yeni bir arka plan kullanılır.</p><div class="cost-row"><span>Yeni katalog</span><strong>200 token</strong></div><p class="upload-help">Üretim birkaç dakika sürebilir. Tamamlanana kadar sayfayı açık tut. Fotoğraflar görsel üretimi için OpenAI'a gönderilir.</p><button class="btn btn-primary w-100" type="submit" id="generate">Kataloğu oluştur · 200 token</button><p id="progress" class="generation-progress" role="status" hidden>Kataloğun hazırlanıyor. Bu sayfayı açık tut…</p></section>
</div></div></form>