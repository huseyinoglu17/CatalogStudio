@model List<Catalog>
@{ViewData["Title"]="Kataloglarım";}
<div class="page-heading"><div><p class="eyebrow">MARKA ARŞİVİ</p><h1>Kataloglarım <span class="count-tag">@Model.Count</span></h1><p>Tüm katalogların, tek bir yerde.</p></div><a class="btn btn-primary" href="/">Yeni katalog oluştur</a></div>
@if(Model.Count==0){<section class="panel empty-state"><span class="empty-symbol" aria-hidden="true">＋</span><h2>İlk kataloğun burada yerini alsın.</h2><p>Ürün fotoğraflarını yükleyerek başlayabilirsin.</p><a class="btn btn-primary" href="/">Katalog oluştur</a></section>}else{
<div class="catalog-grid">@foreach(var c in Model){<article class="catalog-card"><a class="catalog-cover" href="/Catalog/Result/@c.Id"><img src="/Catalog/Image/@c.Id" alt="@c.ProductCode ürün kataloğunu görüntüle" loading="lazy" width="1400" height="1100"/></a><div class="catalog-info"><div class="catalog-title"><a href="/Catalog/Result/@c.Id"><strong>#@c.ProductCode</strong></a><time datetime="@c.CreatedAt.ToString("O")">@c.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</time></div><div class="catalog-tags"><span>@c.Age</span>@if(c.SeriesCount.HasValue){<span>@c.SeriesCount pieces</span>}</div></div><div class="card-actions"><a class="btn btn-outline-dark" href="/Catalog/Result/@c.Id">Görüntüle</a><form asp-controller="Catalog" asp-action="Delete" method="post" data-confirm="Bu katalog kalıcı olarak silinsin mi?"><input type="hidden" name="id" value="@c.Id"/><button class="btn btn-delete" aria-label="@c.ProductCode kataloğunu sil">Sil</button></form></div></article>}</div>}